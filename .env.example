# Vercel loyihasiga shu o'zgaruvchilarni qo'shing (Settings -> Environment Variables)

TELEGRAM_BOT_TOKEN=            # @BotFather
ANTHROPIC_API_KEY=             # console.anthropic.com
META_ACCESS_TOKEN=             # Business Manager -> System Users -> Generate Token
META_AD_ACCOUNT_ID=            # act_1234567890 formatida
META_PAGE_ID=                  # ixtiyoriy, Instant Form/ad creative uchun

# Cron endpointlarni (/api/cron/daily, /api/cron/budget) himoyalash uchun
# o'zingiz o'ylab topgan tasodifiy uzun matn (masalan: openssl rand -hex 24)
CRON_SECRET=

# Vercel KV ulaganda (Storage -> Create -> KV) bular AVTOMATIK qo'shiladi —
# qo'lda kiritish shart emas. Mustaqil Upstash Redis ishlatsangiz, shu ikkitasini
# (yoki UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN) qo'lda kiriting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
