# Vercel loyihasiga shu o'zgaruvchilarni qo'shing (Settings -> Environment Variables)

TELEGRAM_BOT_TOKEN=            # @BotFather
ANTHROPIC_API_KEY=             # console.anthropic.com -- Targetolog/Marketolog HAQIQIY qaror/vazifa uchun (har doim shu, Sonnet)

# Ixtiyoriy -- sozlansa, YENGIL so'rovlar (intent aniqlash, oddiy metrika
# savoliga javob, erkin suhbat, byudjet xabarini tushunish) ANTHROPIC_API_KEY
# o'rniga shu orqali (odatda arzonroq) bajariladi. Sozlanmasa, avvalgidek
# Claude Haiku ishlatiladi -- hech narsa buzilmaydi.
OPENAI_API_KEY=                # platform.openai.com -- ixtiyoriy
OPENAI_MODEL=                  # ixtiyoriy, standart gpt-4o-mini
META_ACCESS_TOKEN=             # Business Manager -> System Users -> Generate Token
META_AD_ACCOUNT_ID=            # act_1234567890 formatida
META_PAGE_ID=                  # ixtiyoriy, Instant Form/ad creative uchun

# Cron endpointlarni (/api/cron/daily, /api/cron/budget) himoyalash uchun
# o'zingiz o'ylab topgan tasodifiy uzun matn (masalan: openssl rand -hex 24)
CRON_SECRET=

# Vercel KV ulaganda (Storage -> Create -> KV) bular AVTOMATIK qo'shiladi —
# qo'lda kiritish shart emas. Mustaqil Upstash Redis ishlatsangiz, shu ikkitasini
# (yoki UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN) qo'lda kiriting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Kunlik hisobot ikkita Telegram guruhga (agentlar guruhi + hisobot guruhi)
# yuborilishi uchun ixtiyoriy — guruh chat_id'sini bilish uchun: botni guruhga
# qo'shing, guruhda bir xabar yozing, keyin brauzerda oching:
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# va natijadagi "chat":{"id": -100...} qiymatini shu yerga qo'ying.
TELEGRAM_AGENTS_GROUP_ID=
TELEGRAM_REPORT_GROUP_ID=
